# API Keys for Phase 1 Data Collectors
# Copy this file to .env and fill in the values below

# Reddit API Credentials
# Get these from https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=myntra_wishlist_scraper:v1.0 (by /u/your_username)

# YouTube API Credentials
# Get this from Google Cloud Console
YOUTUBE_API_KEY=your_youtube_api_key_here

# Database URI (Defaults to local SQLite for Phase 1 testing)
DATABASE_URI=sqlite:///phase1_data.db
